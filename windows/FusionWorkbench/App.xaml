<Application x:Class="FusionWorkbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
                <!--
                    Default language dictionary. The active language dictionary is re-ordered at
                    runtime by App.ApplyLanguageCore so every DynamicResource re-resolves without
                    restarting the application.
                -->
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
