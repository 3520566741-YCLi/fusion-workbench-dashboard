<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cv="clr-namespace:FusionWorkbench.Converters">

    <!-- ============================= Palette ============================= -->
    <SolidColorBrush x:Key="BrushWindowBg"      Color="#0C1017" />
    <SolidColorBrush x:Key="BrushToolbarBg"     Color="#141A24" />
    <SolidColorBrush x:Key="BrushCardBg"        Color="#D91B2433" />
    <SolidColorBrush x:Key="BrushCardBorder"    Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="BrushDivider"       Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BrushTextPrimary"   Color="#EDEFF4" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#9BA3B0" />
    <SolidColorBrush x:Key="BrushMint"          Color="#34D399" />
    <SolidColorBrush x:Key="BrushAmber"         Color="#F5B041" />
    <SolidColorBrush x:Key="BrushGray"          Color="#8A93A3" />
    <SolidColorBrush x:Key="BrushMutedDot"      Color="#5B6472" />

    <!-- ============================ Converters =========================== -->
    <cv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <cv:UsageToBrushConverter x:Key="UsageBrush" />

    <!-- =========================== Effects =============================== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#000000" />

    <!-- ======================== Card chrome style ======================= -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{StaticResource BrushCardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- ============================ Text styles ========================== -->
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextStatus" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="TextRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TextRowValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TextStatTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TextStatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Separator (divider) -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource BrushDivider}" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- ==================== Usage progress bar (0..1) ====================
         Keeps the WPF control part names (PART_Track / PART_Indicator) so the
         ProgressBar itself sizes the indicator proportionally to Value/Maximum. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Background" Value="#2EFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons (flat, dark-theme friendly). -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Background" Value="#1E2A3A" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#2A3B50" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#16202E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Language toggle buttons (RadioButton pair). -->
    <Style x:Key="LanguageToggle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#223349" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BrushMint}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1C2938" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small centered "status chip" used by cards that only show a message. -->
    <Style x:Key="StatusPanel" TargetType="Border">
        <Setter Property="Background" Value="#14202F" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

</ResourceDictionary>
