<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Card titles -->
    <sys:String x:Key="CardTitle_Weather">Nullschool Earth Weather</sys:String>
    <sys:String x:Key="CardTitle_System">Local System Status</sys:String>
    <sys:String x:Key="CardTitle_Codex">Codex Live Status</sys:String>
    <sys:String x:Key="CardTitle_CommandCode">Command Code Live Status</sys:String>
    <sys:String x:Key="CardTitle_GitHub">GitHub Account Overview</sys:String>
    <sys:String x:Key="CardTitle_MakerWorld">MakerWorld Account Overview</sys:String>
    <sys:String x:Key="CardTitle_Harness">DeepSeek Harness Status</sys:String>

    <!-- Toolbar / window -->
    <sys:String x:Key="Lbl_Language">Language</sys:String>
    <sys:String x:Key="Lbl_English">English</sys:String>
    <sys:String x:Key="Lbl_Chinese">中文</sys:String>
    <sys:String x:Key="Lbl_Settings">Settings</sys:String>
    <sys:String x:Key="Lbl_RefreshNow">Refresh now</sys:String>
    <sys:String x:Key="Lbl_AutoRefresh">Auto-refresh every {0} s</sys:String>
    <sys:String x:Key="Lbl_NextIn">next in {0} s</sys:String>
    <sys:String x:Key="Lbl_Refreshing">Refreshing…</sys:String>
    <sys:String x:Key="Lbl_LastRefresh">Last refresh {0}</sys:String>

    <!-- Status words -->
    <sys:String x:Key="Status_Checking">Checking…</sys:String>
    <sys:String x:Key="Status_Available">Available</sys:String>
    <sys:String x:Key="Status_Unavailable">Unavailable</sys:String>
    <sys:String x:Key="Status_Connected">Connected</sys:String>
    <sys:String x:Key="Status_Monitoring">Monitoring</sys:String>

    <!-- Status messages -->
    <sys:String x:Key="Msg_WaitingFirstSample">Waiting for the first sample…</sys:String>
    <sys:String x:Key="Msg_SystemUnavailable">System metrics could not be read on this PC.</sys:String>
    <sys:String x:Key="Msg_GhNotFound">GitHub CLI (gh) was not found on PATH. Install it with winget install GitHub.cli, then sign in with gh auth login.</sys:String>
    <sys:String x:Key="Msg_GhNotAuthenticated">GitHub CLI is not authenticated. Run gh auth login and try again.</sys:String>
    <sys:String x:Key="Msg_GhCommandFailed">GitHub CLI request failed: {0}</sys:String>
    <sys:String x:Key="Msg_NetworkError">Network error: {0}</sys:String>
    <sys:String x:Key="Msg_Timeout">The request timed out.</sys:String>
    <sys:String x:Key="Msg_HttpError">The server returned HTTP {0}.</sys:String>
    <sys:String x:Key="Msg_ConfigureMakerWorldId">Set your MakerWorld user ID (Settings) to enable this card.</sys:String>
    <sys:String x:Key="Msg_InvalidMakerWorldId">The MakerWorld user ID must be a whole number (the numeric part of your profile URL).</sys:String>
    <sys:String x:Key="Msg_MacOSOnly_Harness">This data source only exists in the macOS build: it reads the local DeepSeek Harness store (~/.dsh) that the macOS desktop app maintains. No equivalent store exists on Windows.</sys:String>
    <sys:String x:Key="Msg_MacOSOnly_Codex">This data source only exists in the macOS build: it talks to the local Codex app-server binary that ships inside the macOS ChatGPT app. There is no equivalent service on Windows.</sys:String>
    <sys:String x:Key="Msg_MacOSOnly_CommandCode">This data source only exists in the macOS build: it runs the Command Code CLI that ships inside the macOS Command Code app. There is no equivalent CLI on Windows.</sys:String>
    <sys:String x:Key="Msg_WebView2Missing">The WebView2 Runtime is required to show the earth map. Install the Evergreen WebView2 Runtime (see windows/README.md) and restart Fusion Workbench.</sys:String>
    <sys:String x:Key="Msg_WebViewInitFailed">Could not start the earth map view: {0}</sys:String>
    <sys:String x:Key="Msg_WebLoadFailed">Could not load the earth map: {0}</sys:String>
    <sys:String x:Key="Msg_Retry">Retry</sys:String>

    <!-- Rows / labels -->
    <sys:String x:Key="Lbl_Updated">Updated {0}</sys:String>
    <sys:String x:Key="Lbl_CPU">CPU</sys:String>
    <sys:String x:Key="Lbl_Memory">Memory</sys:String>
    <sys:String x:Key="Lbl_Disk">Disk</sys:String>
    <sys:String x:Key="Lbl_Cores">Logical cores</sys:String>
    <sys:String x:Key="Lbl_OS">Operating system</sys:String>
    <sys:String x:Key="Lbl_None">None</sys:String>
    <sys:String x:Key="Lbl_RecentlyUpdated">Recently updated</sys:String>
    <sys:String x:Key="Lbl_Account">Account</sys:String>
    <sys:String x:Key="Lbl_Joined">Joined</sys:String>
    <sys:String x:Key="Lbl_Organizations">Organizations</sys:String>
    <sys:String x:Key="Lbl_Stat_Public">Public repos</sys:String>
    <sys:String x:Key="Lbl_Stat_Private">Private repos</sys:String>
    <sys:String x:Key="Lbl_Stat_Total">Repos</sys:String>
    <sys:String x:Key="Lbl_Stat_Forks">Forks</sys:String>
    <sys:String x:Key="Lbl_PrivateBadge">private</sys:String>
    <sys:String x:Key="Lbl_ForkBadge">fork</sys:String>
    <sys:String x:Key="Lbl_Name">Name</sys:String>
    <sys:String x:Key="Lbl_Handle">Handle</sys:String>
    <sys:String x:Key="Lbl_Fans">Fans</sys:String>
    <sys:String x:Key="Lbl_Following">Following</sys:String>
    <sys:String x:Key="Lbl_Likes">Likes</sys:String>
    <sys:String x:Key="Lbl_Collections">Collections</sys:String>
    <sys:String x:Key="Lbl_Designs">Designs</sys:String>
    <sys:String x:Key="Lbl_DesignDownloads">Downloads</sys:String>
    <sys:String x:Key="Lbl_DesignPrints">Prints</sys:String>
    <sys:String x:Key="Lbl_Models">Models</sys:String>
    <sys:String x:Key="Lbl_ModelStats">Likes {0} · Downloads {1} · Prints {2}</sys:String>
    <sys:String x:Key="Lbl_WeatherHint">Interactive globe by earth.nullschool.net — drag to rotate, scroll to zoom.</sys:String>
    <sys:String x:Key="Lbl_ConfigureHint">Open Settings to change the MakerWorld user ID.</sys:String>

    <!-- Settings dialog -->
    <sys:String x:Key="Lbl_SettingsTitle">Settings</sys:String>
    <sys:String x:Key="Lbl_AppLanguage">Interface language</sys:String>
    <sys:String x:Key="Lbl_MakerWorldUserId">MakerWorld user ID</sys:String>
    <sys:String x:Key="Lbl_MakerWorldHelp">Numeric part of your MakerWorld profile URL, for example makerworld.com/u/12345678 → 12345678. Leave empty to keep the MakerWorld card unavailable.</sys:String>
    <sys:String x:Key="Lbl_SettingsDescription">These settings are stored locally on this PC.</sys:String>
    <sys:String x:Key="Lbl_Save">Save</sys:String>
    <sys:String x:Key="Lbl_Cancel">Cancel</sys:String>

</ResourceDictionary>
