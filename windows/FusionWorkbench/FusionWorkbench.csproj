<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FusionWorkbench</RootNamespace>
    <AssemblyName>FusionWorkbench</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Fusion Workbench (Windows port)</AssemblyTitle>
    <Description>Windows (WPF) port of the Fusion Workbench macOS dashboard: live system, GitHub and MakerWorld cards plus a Nullschool earth map.</Description>
    <Version>1.0.0</Version>
    <!-- The only third-party package used by this port. Everything else is the BCL. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

</Project>
