<UserControl x:Class="FusionWorkbench.Views.SystemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: status dot + title + status label -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource CardTitle_System}" Style="{StaticResource TextTitle}" />
                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Style="{StaticResource TextStatus}"
                           Foreground="{Binding StatusBrush}" Margin="8,0,0,0" />
            </Grid>

            <Separator Grid.Row="1" />

            <!-- Body -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <!-- Available: live rows -->
                <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Lbl_Cores}" Style="{StaticResource TextRowLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding CoresText}" Style="{StaticResource TextRowValue}" />
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Lbl_OS}" Style="{StaticResource TextRowLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding OsText}" Style="{StaticResource TextRowValue}"
                                   MaxWidth="300" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Lbl_CPU}" Style="{StaticResource TextRowLabel}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource TextRowValue}" />
                    </Grid>
                    <ProgressBar Margin="0,4,0,0" Value="{Binding CpuUsage}"
                                 Foreground="{Binding CpuUsage, Converter={StaticResource UsageBrush}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Lbl_Memory}" Style="{StaticResource TextRowLabel}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" Style="{StaticResource TextRowValue}" />
                    </Grid>
                    <ProgressBar Margin="0,4,0,0" Value="{Binding MemoryUsage}"
                                 Foreground="{Binding MemoryUsage, Converter={StaticResource UsageBrush}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Lbl_Disk}" Style="{StaticResource TextRowLabel}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding DiskText}" Style="{StaticResource TextRowValue}" />
                    </Grid>
                    <ProgressBar Margin="0,4,0,0" Value="{Binding DiskUsage}"
                                 Foreground="{Binding DiskUsage, Converter={StaticResource UsageBrush}}" />
                </StackPanel>

                <!-- Unavailable / first sample: reason panel -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}">
                    <Border Style="{StaticResource StatusPanel}" Margin="0,4">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource TextBody}" TextAlignment="Center" />
                    </Border>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding UpdatedText}" Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
        </Grid>
    </Border>
</UserControl>
