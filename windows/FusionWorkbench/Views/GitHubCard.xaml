<UserControl x:Class="FusionWorkbench.Views.GitHubCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{DynamicResource CardTitle_GitHub}" Style="{StaticResource TextTitle}" />
                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Style="{StaticResource TextStatus}"
                           Foreground="{Binding StatusBrush}" Margin="8,0,0,0" />
            </Grid>

            <Separator Grid.Row="1" />

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <!-- Available: account rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Lbl_Account}" Style="{StaticResource TextRowLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding UsernameText}" Style="{StaticResource TextRowValue}" MaxWidth="260" />
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Lbl_Joined}" Style="{StaticResource TextRowLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding JoinedText}" Style="{StaticResource TextRowValue}" />
                        </Grid>

                        <Separator Margin="0,8" />

                        <!-- Stat chips -->
                        <UniformGrid Columns="4" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Lbl_Stat_Public}" Style="{StaticResource TextStatTitle}" />
                                <TextBlock Text="{Binding PublicReposText}" Style="{StaticResource TextStatValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Lbl_Stat_Private}" Style="{StaticResource TextStatTitle}" />
                                <TextBlock Text="{Binding PrivateReposText}" Style="{StaticResource TextStatValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Lbl_Stat_Total}" Style="{StaticResource TextStatTitle}" />
                                <TextBlock Text="{Binding TotalReposText}" Style="{StaticResource TextStatValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,6">
                                <TextBlock Text="{DynamicResource Lbl_Stat_Forks}" Style="{StaticResource TextStatTitle}" />
                                <TextBlock Text="{Binding ForksText}" Style="{StaticResource TextStatValue}" />
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Lbl_Organizations}" Style="{StaticResource TextRowLabel}"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding OrgsText}" Style="{StaticResource TextRowValue}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Separator Margin="0,8" />

                        <TextBlock Text="{DynamicResource Lbl_RecentlyUpdated}" Style="{StaticResource TextRowLabel}"
                                   FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding RecentRepositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextRowValue}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Badge}" Style="{StaticResource TextCaption}"
                                                   Foreground="{StaticResource BrushAmber}" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding StarsText}" Style="{StaticResource TextCaption}"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Unavailable -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}">
                    <Border Style="{StaticResource StatusPanel}" Margin="0,4">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource TextBody}" TextAlignment="Center" />
                    </Border>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding UpdatedText}" Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
        </Grid>
    </Border>
</UserControl>
